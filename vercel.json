{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index?p=:path*"
    },
    {
      "source": "/live",
      "destination": "/live.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/simulate",
      "destination": "/simulate.html"
    },
    {
      "source": "/track",
      "destination": "/track.html"
    },
    {
      "source": "/gestisci",
      "destination": "/gestisci.html"
    },
    {
      "source": "/crea",
      "destination": "/crea.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/report",
      "destination": "/report.html"
    },
    {
      "source": "/condizioni",
      "destination": "/condizioni.html"
    },
    {
      "source": "/demo",
      "destination": "/live.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/((?!privacy|demo|condizioni|site\\.css|img|css|fonts|logo-mark\\.svg|robots\\.txt|$).*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/archive",
      "schedule": "17 3 * * *"
    }
  ]
}